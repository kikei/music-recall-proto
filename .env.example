# The LLM API key is no longer set here: each account enters its own from the
# settings screen, so calls are billed to whoever made them.

# Encrypts the API keys accounts enter (required). Generate with:
#   openssl rand -base64 32
# Losing this means every account has to enter its keys again; there is
# deliberately no recovery path.
CREDENTIAL_SECRET=

# Model choices (provider, per-use models, web search context, per-model
# options) live in server/llm/model-config.ts, not here.

# Sign-in (required). Any standard OIDC provider works; Logto is what we use.
# Point these at the development tenant locally and the production tenant when
# deployed, so test accounts never mix with real ones.
# OIDC_ISSUER is the token issuer (Logto: https://<tenant>.logto.app/oidc).
# OIDC_AUDIENCE is the API resource indicator you registered; without a matching
# API resource the provider issues an opaque token that cannot be verified.
OIDC_ISSUER=
OIDC_AUDIENCE=

# The same tenant, as seen by the browser. VITE_ vars are exposed to the client
# (these are public identifiers, not secrets).
VITE_LOGTO_ENDPOINT=
VITE_LOGTO_APP_ID=
VITE_LOGTO_RESOURCE=

# SQLite file path
DB_PATH=data/music-recall.sqlite

# Backend port
PORT=8787

# Viewing player (optional). Spotify is preferred; YouTube is used otherwise.
# These are the operator's shared keys, used for every account that has not
# entered its own. Unlike the LLM key they identify the application rather than
# a person, and the app still works without them (paste a URL and it embeds).
# Spotify: register an app at https://developer.spotify.com -> Client
# Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 key (Google Cloud)
YOUTUBE_API_KEY=
